cask_args appdir: '/Applications'

# Terminal configs
brew 'starship'
brew 'shellcheck'
brew 'tmux'
cask 'codex'

# Utils
brew 'ag'
brew 'aspell'
brew 'coreutils'
brew 'dos2unix'
brew 'entr'
brew 'git'
brew 'miller'
cask '1password-cli'
brew 'rg'
brew 'terminal-notifier'
brew 'tree'
brew 'wget'
brew 'btop'
brew 'gum'
brew 'fzf'
brew 'csvkit'
brew 'visidata'
brew 'plantuml'
brew 'fd'
brew 'yazi'


# Env Management
brew 'chruby'
brew 'ruby-install'
brew 'direnv'
brew 'pipx'
brew 'nvm'


# Trying out
brew 'tlrc'
# brew 'neovim'
brew 'mkcert'
brew 'pyenv'
brew 'pyenv-virtualenv'
brew 'ttyd'
brew 'mermaid-cli'
brew 'gurgeous/tap/tennis', trusted: true
brew 'jq'
brew 'anomalyco/tap/opencode', trusted: true
cask 'soulver-cli'
